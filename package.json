{
  "name": "projectops",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ProjectOps: client and project operations application on raw Node.js and PostgreSQL",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "verify": "node scripts/verify-integrity.mjs",
    "typecheck": "tsc -p tsconfig.json && tsc -p apps/client/tsconfig.json",
    "build": "vite build --config apps/client/vite.config.ts",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "start": "node --experimental-strip-types apps/api/src/projectops/main.ts",
    "operator:create": "node --experimental-strip-types apps/api/src/projectops/provision-operator.ts",
    "test:postgres": "node --experimental-strip-types --test tests/integration/*-postgres.test.ts",
    "test:browser": "node --experimental-strip-types --test tests/integration/*-browser.test.ts"
  },
  "dependencies": {
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "playwright": "1.64.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
